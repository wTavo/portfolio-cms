---
/**
 * @file index.astro
 * @description Showcase principal del dúo de creadores e ingenieros de software.
 */

import SEOHead from '../components/ui/SEOHead.astro';
import Icon from '../components/icons/Icon.astro';
import DualShowcase from '../components/home/DualShowcase';
import { getShowcaseData } from '../lib/services/showcase.service';
import { i18n } from '../lib/i18n/es';
import '../styles/global.css';

const showcaseData = await getShowcaseData();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead
      title={`${i18n.showcase.heroTitle} — Portafolio Builder`}
      description={i18n.showcase.heroSubtitle}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg-base)] text-[var(--color-text-primary)] antialiased relative overflow-x-hidden selection:bg-[var(--color-brand-primary)] selection:text-[var(--color-brand-on-primary)]">
    <!-- Gradientes ambientales de iluminación de fondo -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-radial from-[var(--color-brand-accent)]/10 via-[var(--color-brand-primary)]/5 to-transparent blur-3xl pointer-events-none -z-10"
      aria-hidden="true"
    ></div>

    <!-- Barra de Navegación Superior -->
    <header class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-surface)]/80 backdrop-blur-md py-4 px-6 sticky top-0 z-30 transition-colors">
      <div class="max-w-(--container-max-w) mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 font-bold text-base sm:text-lg tracking-tight text-[var(--color-text-primary)] hover:opacity-90 transition-opacity">
          <div class="p-1.5 rounded-[var(--radius-sm)] bg-[var(--color-bg-subtle)] border border-[var(--color-border-subtle)]">
            <Icon name="rocket" class="w-4 h-4 text-[var(--color-brand-accent)]" />
          </div>
          <span>Portafolio Builder</span>
        </a>

        <a
          href="/login"
          class="min-h-(--size-touch-target) px-4 py-2 rounded-[var(--radius-md)] bg-[var(--color-bg-subtle)] border border-[var(--color-border-default)] text-xs font-semibold text-[var(--color-text-primary)] hover:bg-[var(--color-bg-muted)] hover:border-[var(--color-brand-accent)] transition-all inline-flex items-center gap-1.5"
        >
          <span>Acceso</span>
        </a>
      </div>
    </header>

    <!-- Encabezado Cinemático del Showcase -->
    <section class="pt-16 sm:pt-20 pb-12 text-center px-4 max-w-(--container-narrow-w) mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] text-xs font-semibold text-[var(--color-text-secondary)] shadow-[var(--shadow-card)]">
        <Icon name="sparkles" class="w-3.5 h-3.5 text-[var(--color-brand-accent)]" />
        <span>{i18n.showcase.badge}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-[var(--color-text-primary)]">
        {i18n.showcase.heroTitle}
      </h1>

      <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-xl mx-auto pt-2">
        {i18n.showcase.heroSubtitle}
      </p>
    </section>

    <!-- Showcase Dual Interactivo -->
    <main class="flex-1 pb-20">
      <DualShowcase client:load data={showcaseData} />
    </main>

    <!-- Pie de Página -->
    <footer class="border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-surface)] py-8 text-center text-xs text-[var(--color-text-muted)]">
      <p>© {new Date().getFullYear()} Portafolio Builder • Crafted with Astro, React & Cloudflare</p>
    </footer>
  </body>
</html>
