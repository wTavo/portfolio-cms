---
/**
 * @file index.astro
 * @description Directorio público principal de portafolios y talentos profesionales.
 */

import SEOHead from '../components/ui/SEOHead.astro';
import Icon from '../components/icons/Icon.astro';
import DirectoryExplorer from '../components/directory/DirectoryExplorer';
import { getPublishedDirectoryProfiles } from '../lib/services/directory.service';
import { i18n } from '../lib/i18n/es';
import '../styles/global.css';

const initialProfiles = await getPublishedDirectoryProfiles();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead
      title={`${i18n.directory.heroTitle} — Portafolio Builder`}
      description={i18n.directory.heroSubtitle}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg-base)] text-[var(--color-text-primary)] antialiased">
    <!-- Barra de Navegación Superior -->
    <header class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-surface)] py-4 px-6 sticky top-0 z-30">
      <div class="max-w-(--container-max-w) mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-bold text-lg tracking-tight text-[var(--color-text-primary)]">
          <Icon name="rocket" class="w-5 h-5 text-[var(--color-brand-accent)]" />
          <span>Portafolio Builder</span>
        </a>

        <a
          href="/login"
          class="min-h-(--size-touch-target) px-4 py-2 rounded-[var(--radius-md)] bg-[var(--color-bg-subtle)] border border-[var(--color-border-default)] text-xs font-semibold text-[var(--color-text-primary)] hover:bg-[var(--color-bg-muted)] transition-colors inline-flex items-center"
        >
          {i18n.auth.loginTitle}
        </a>
      </div>
    </header>

    <!-- Encabezado Hero del Directorio -->
    <section class="pt-14 pb-6 text-center px-4 max-w-(--container-narrow-w) mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] text-xs font-semibold text-[var(--color-text-secondary)] mb-4 shadow-[var(--shadow-card)]">
        <Icon name="sparkles" class="w-3.5 h-3.5 text-[var(--color-brand-accent)]" />
        <span>Comunidad de talentos verificados</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
        {i18n.directory.heroTitle}
      </h1>
      <p class="text-sm sm:text-base text-[var(--color-text-secondary)] leading-relaxed max-w-xl mx-auto">
        {i18n.directory.heroSubtitle}
      </p>
    </section>

    <!-- Explorador Reactivo de Portafolios -->
    <main class="flex-1 pb-16">
      <DirectoryExplorer client:load initialProfiles={initialProfiles} />
    </main>

    <!-- Pie de Página -->
    <footer class="border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-surface)] py-8 text-center text-xs text-[var(--color-text-muted)]">
      <p>© {new Date().getFullYear()} Portafolio Builder CMS • Desarrollado con Astro y Cloudflare</p>
    </footer>
  </body>
</html>
