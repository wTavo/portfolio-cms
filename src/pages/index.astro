---
/**
 * @file index.astro
 * @description Landing page de la plataforma Portafolio Builder CMS.
 */

import SEOHead from '../components/ui/SEOHead.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead
      title="Portafolio Builder CMS — Crea tu portafolio profesional"
      description="Plataforma moderna para crear, administrar y publicar portafolios profesionales de alto impacto visual."
    />
  </head>
  <body class="min-h-screen flex flex-col justify-between bg-[var(--color-bg-base)] text-[var(--color-text-primary)] antialiased">
    <header class="border-b border-[var(--color-border-subtle)] py-4 px-6 max-w-(--container-max-w) mx-auto w-full flex items-center justify-between">
      <span class="font-bold text-lg tracking-tight">Portafolio Builder</span>
      <a
        href="/login"
        class="min-h-(--size-touch-target) px-4 py-2 rounded-[var(--radius-md)] bg-[var(--color-bg-subtle)] border border-[var(--color-border-default)] text-sm font-medium hover:bg-[var(--color-bg-muted)] transition-colors flex items-center"
      >
        Iniciar sesión
      </a>
    </header>

    <main class="max-w-(--container-narrow-w) mx-auto px-4 py-20 text-center flex-1 flex flex-col items-center justify-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--color-bg-subtle)] border border-[var(--color-border-subtle)] text-xs font-semibold text-[var(--color-text-secondary)] mb-6">
        🚀 Nueva plataforma
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
        Tu portafolio profesional, moderno y dinámico
      </h1>
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] mb-10 leading-relaxed max-w-xl">
        Administra tu contenido fácilmente mientras disfrutas de una experiencia visual de alto rendimiento creada con Astro y Supabase.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/gustavo"
          class="min-h-(--size-touch-target) px-6 py-3 rounded-[var(--radius-md)] bg-[var(--color-brand-primary)] text-[var(--color-brand-on-primary)] font-medium text-sm sm:text-base hover:opacity-90 transition-opacity shadow-[var(--shadow-card)] flex items-center"
        >
          Ver portafolio de ejemplo
        </a>
        <a
          href="/login"
          class="min-h-(--size-touch-target) px-6 py-3 rounded-[var(--radius-md)] bg-[var(--color-bg-subtle)] border border-[var(--color-border-default)] text-[var(--color-text-primary)] font-medium text-sm sm:text-base hover:bg-[var(--color-bg-muted)] transition-colors flex items-center"
        >
          Acceso al panel
        </a>
      </div>
    </main>

    <footer class="border-t border-[var(--color-border-subtle)] py-6 text-center text-xs text-[var(--color-text-muted)]">
      © {new Date().getFullYear()} Portafolio Builder CMS • Desarrollado con Astro y Cloudflare
    </footer>
  </body>
</html>
