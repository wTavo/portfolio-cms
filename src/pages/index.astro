---
/**
 * @file index.astro
 * @description Showcase principal del dúo de creadores e ingenieros de software con presentación cinemática por estados.
 */

import SEOHead from '../components/ui/SEOHead.astro';
import DualShowcase from '../components/home/DualShowcase';
import { getShowcaseData } from '../lib/services/showcase.service';
import { i18n } from '../lib/i18n/es';
import '../styles/global.css';

const showcaseData = await getShowcaseData();
---

<!doctype html>
<html lang="es" class="h-full overflow-hidden">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead
      title={`${i18n.showcase.title} — Portfolio CMS`}
      description={i18n.showcase.subtitle}
    />
  </head>
  <body class="h-full bg-[var(--color-bg-base)] text-[var(--color-text-primary)] antialiased relative overflow-hidden selection:bg-[var(--color-brand-primary)] selection:text-[var(--color-brand-on-primary)]">
    <!-- Gradiente ambiental sutil de iluminación de fondo (sin filtro blur, cero costo GPU) -->
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] pointer-events-none z-0 opacity-60 dark:opacity-40"
      style="background: radial-gradient(ellipse at center, var(--color-brand-accent) 0%, rgba(99, 102, 241, 0.06) 40%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <!-- Showcase Dual Interactivo por Estados Cinemáticos -->
    <main class="h-full">
      <DualShowcase client:load data={showcaseData} />
    </main>
  </body>
</html>
