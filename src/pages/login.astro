---
/**
 * @file login.astro
 * @description Pantalla de inicio de sesión unificada para Owners y Superadmin.
 */

import SEOHead from '../components/ui/SEOHead.astro';
import { i18n } from '../lib/i18n/es';
import '../styles/global.css';

const errorParam = Astro.url.searchParams.get('error');
const redirectParam = Astro.url.searchParams.get('redirect') || '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead
      title={`${i18n.auth.loginTitle} — Portfolio Builder`}
      description={i18n.auth.loginSubtitle}
    />
  </head>
  <body class="min-h-screen flex items-center justify-center bg-[var(--color-bg-base)] text-[var(--color-text-primary)] px-4 py-12">
    <div class="w-full max-w-md p-8 rounded-[var(--radius-xl)] bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] shadow-[var(--shadow-modal)]">
      <div class="text-center mb-8">
        <a href="/" class="inline-block text-xs font-semibold uppercase tracking-wider text-[var(--color-brand-accent)] mb-3">
          ← Volver al inicio
        </a>
        <h1 class="text-2xl font-bold tracking-tight text-[var(--color-text-primary)]">
          {i18n.auth.loginTitle}
        </h1>
        <p class="text-sm text-[var(--color-text-secondary)] mt-1">
          {i18n.auth.loginSubtitle}
        </p>
      </div>

      {errorParam === 'account_suspended' && (
        <div class="mb-6 p-4 rounded-[var(--radius-md)] bg-[var(--color-status-error-bg)] border border-[var(--color-status-error)] text-[var(--color-status-error)] text-xs font-medium" role="alert">
          {i18n.auth.accountSuspended}
        </div>
      )}

      <div id="error-banner" class="hidden mb-6 p-4 rounded-[var(--radius-md)] bg-[var(--color-status-error-bg)] border border-[var(--color-status-error)] text-[var(--color-status-error)] text-xs font-medium" role="alert"></div>

      <form id="login-form" class="space-y-5" novalidate>
        <input type="hidden" id="redirect-url" value={redirectParam} />

        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-2">
            {i18n.auth.emailLabel}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="usuario@ejemplo.com"
            class="w-full min-h-(--size-input-height) px-4 rounded-[var(--radius-md)] bg-[var(--color-bg-base)] border border-[var(--color-border-default)] text-[var(--color-text-primary)] text-sm focus:border-[var(--color-brand-accent)] focus:outline-none transition-colors"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] mb-2">
            {i18n.auth.passwordLabel}
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full min-h-(--size-input-height) px-4 rounded-[var(--radius-md)] bg-[var(--color-bg-base)] border border-[var(--color-border-default)] text-[var(--color-text-primary)] text-sm focus:border-[var(--color-brand-accent)] focus:outline-none transition-colors"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full min-h-(--size-button-height) px-6 rounded-[var(--radius-md)] bg-[var(--color-brand-primary)] text-[var(--color-brand-on-primary)] text-sm font-semibold hover:opacity-90 transition-opacity flex items-center justify-center gap-2 shadow-[var(--shadow-card)] disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
          <span id="btn-text">{i18n.auth.loginButton}</span>
          <span id="btn-spinner" class="hidden w-4 h-4 border-2 border-[var(--color-brand-on-primary)] border-t-transparent rounded-full animate-spin"></span>
        </button>
      </form>
    </div>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const errorBanner = document.getElementById('error-banner') as HTMLDivElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const btnText = document.getElementById('btn-text') as HTMLSpanElement;
      const btnSpinner = document.getElementById('btn-spinner') as HTMLSpanElement;
      const redirectInput = document.getElementById('redirect-url') as HTMLInputElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorBanner.classList.add('hidden');
        errorBanner.textContent = '';

        const email = (document.getElementById('email') as HTMLInputElement).value.trim();
        const password = (document.getElementById('password') as HTMLInputElement).value;

        if (!email || !password) {
          errorBanner.textContent = 'Por favor completa todos los campos.';
          errorBanner.classList.remove('hidden');
          return;
        }

        // Idempotencia: Bloqueo de doble clic y estado de carga (DIR-20)
        submitBtn.disabled = true;
        btnText.textContent = 'Verificando...';
        btnSpinner.classList.remove('hidden');

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });

          const result = await res.json();

          if (!res.ok || !result.success) {
            errorBanner.textContent = result.error?.message || 'Error al iniciar sesión.';
            errorBanner.classList.remove('hidden');
            submitBtn.disabled = false;
            btnText.textContent = 'Entrar';
            btnSpinner.classList.add('hidden');
            return;
          }

          // Redirección exitosa por rol
          const targetUrl = redirectInput.value || result.data.redirectUrl || '/dashboard';
          window.location.href = targetUrl;
        } catch {
          errorBanner.textContent = 'Error de conexión. Intenta nuevamente.';
          errorBanner.classList.remove('hidden');
          submitBtn.disabled = false;
          btnText.textContent = 'Entrar';
          btnSpinner.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
