---
/**
 * @file index.astro
 * @description Panel principal del Superadmin con gestión reactiva de usuarios.
 */

import SEOHead from '../../components/ui/SEOHead.astro';
import UserManager from '../../components/admin/UserManager';
import { i18n } from '../../lib/i18n/es';
import '../../styles/global.css';

const currentUser = Astro.locals.user;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead
      title="Superadmin — Administración Global"
      description="Gestión general de usuarios y portfolios de la plataforma."
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg-base)] text-[var(--color-text-primary)] antialiased">
    <header class="border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-surface)] py-4 px-6 sticky top-0 z-30">
      <div class="max-w-(--container-max-w) mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-[var(--radius-sm)] bg-[var(--color-status-error-bg)] text-[var(--color-status-error)] text-xs font-bold uppercase tracking-wider">
            Superadmin
          </span>
          <h1 class="text-base sm:text-lg font-bold">Control de Plataforma</h1>
        </div>

        <div class="flex items-center gap-4">
          <span class="text-xs font-medium text-[var(--color-text-secondary)] hidden sm:inline">
            {currentUser?.email}
          </span>
          <button
            id="logout-btn"
            class="min-h-(--size-touch-target) px-3 py-1.5 rounded-[var(--radius-md)] bg-[var(--color-bg-subtle)] border border-[var(--color-border-default)] text-xs font-semibold hover:bg-[var(--color-bg-muted)] transition-colors cursor-pointer"
          >
            {i18n.common.logout}
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-(--container-max-w) mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
      <!-- Isla interactiva de React con client:load -->
      <UserManager client:load />
    </main>

    <script>
      const logoutBtn = document.getElementById('logout-btn');
      logoutBtn?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      });
    </script>
  </body>
</html>
