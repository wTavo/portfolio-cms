---
/**
 * @file Icon.astro
 * @description Componente centralizado de Astro para renderizar iconos y diseños SVG reutilizables.
 */

import type { IconName } from './types';

interface Props {
  name: IconName;
  class?: string;
  size?: number | string;
  ariaLabel?: string;
}

const { name, class: className = 'w-4 h-4', size, ariaLabel } = Astro.props;
const dimensionProps = size ? { width: size, height: size } : {};
