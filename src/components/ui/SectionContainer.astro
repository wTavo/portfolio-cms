---
/**
 * @file SectionContainer.astro
 * @description Contenedor estandarizado para secciones del portfolio respetando tokens y accesibilidad.
 */

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  className?: string;
  isHero?: boolean;
}

const { id, title, subtitle, className = '', isHero = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    'w-full max-w-(--container-max-w) mx-auto px-4 sm:px-6 lg:px-8',
    isHero ? 'py-12 sm:py-20 lg:py-28' : 'py-12 sm:py-16',
    className,
  ]}
>
  {title && (
    <div class="mb-8 sm:mb-12 text-left">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text-primary)]">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-2 text-base text-[var(--color-text-secondary)]">
          {subtitle}
        </p>
      )}
      <div class="mt-4 w-12 h-1 rounded-full bg-[var(--color-brand-primary)] opacity-80" aria-hidden="true"></div>
    </div>
  )}
  <slot />
</section>
