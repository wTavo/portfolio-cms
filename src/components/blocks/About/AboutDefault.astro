---
/**
 * @file AboutDefault.astro
 * @description Bloque Sobre Mí con párrafos informativos y métricas destacadas.
 */

import SectionContainer from '../../ui/SectionContainer.astro';
import type { AboutBlockData } from '../../../lib/types/portfolio';

interface Props {
  title?: string;
  data: AboutBlockData;
}

const { title = 'Sobre mí', data } = Astro.props;
---

<SectionContainer id="sobre-mi" title={title}>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-start">
    <div class="lg:col-span-2 space-y-4 text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed">
      {data.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    {data.highlights && data.highlights.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-1 gap-4">
        {data.highlights.map((highlight) => (
          <div class="p-5 rounded-[var(--radius-lg)] bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] shadow-[var(--shadow-card)]">
            <span class="block text-2xl sm:text-3xl font-bold text-[var(--color-text-primary)]">
              {highlight.value}
            </span>
            <span class="block text-xs sm:text-sm font-medium text-[var(--color-text-muted)] mt-1">
              {highlight.label}
            </span>
          </div>
        ))}
      </div>
    )}
  </div>
</SectionContainer>
