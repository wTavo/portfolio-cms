---
/**
 * @file SkillsBadges.astro
 * @description Bloque Habilidades variante 'badges': categorización clara en etiquetas accesibles.
 */

import SectionContainer from '../../ui/SectionContainer.astro';
import type { SkillsBlockData } from '../../../lib/types/portfolio';

interface Props {
  title?: string;
  data: SkillsBlockData;
}

const { title = 'Habilidades técnicas', data } = Astro.props;
---

<SectionContainer id="habilidades" title={title}>
  {data.categories && (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {data.categories.map((category) => (
        <div class="p-6 rounded-[var(--radius-lg)] bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] shadow-[var(--shadow-card)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-4 pb-2 border-b border-[var(--color-border-subtle)]">
            {category.name}
          </h3>
          <ul class="flex flex-wrap gap-2" role="list">
            {category.skills.map((skill) => (
              <li>
                <span class="inline-block px-3 py-1.5 text-xs font-medium rounded-[var(--radius-md)] bg-[var(--color-bg-subtle)] text-[var(--color-text-primary)] border border-[var(--color-border-subtle)]">
                  {skill}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</SectionContainer>
